{
  "name": "forked-win-get-updates",
  "version": "0.0.9-SNAPSHOT",
  "description": "Forked third party CLI frontend for winget update runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigabitzauber/fwgu.git"
  },
  "homepage": "https://github.com/gigabitzauber/fwgu",
  "bugs": {
    "url": "https://github.com/gigabitzauber/fwgu/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "fwgu": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "prebuild": "npm run version:gen",
    "version:gen": "node -p \"'const FWGU_VERSION = \\'' + require('./package.json').version + '\\';\\nexport default FWGU_VERSION;'\" > src/lib/version.js",
    "test": "vitest run",
    "tests": "npm run test --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "winget",
    "update",
    "windows",
    "cli"
  ],
  "author": "Jan Mosig",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "vitest": "4.1.9"
  },
  "overrides": {},
  "override-comments": {}
}
